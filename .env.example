# ========================================================
# BOKKEN ESTUDOS — CONFIGURAÇÃO GERAL DE VARIÁVEIS DE AMBIENTE
# ========================================================

# BACKEND
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# BANCO DE DADOS (PostgreSQL)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/bokken_db?schema=public

# SEGURANÇA E AUTENTICAÇÃO
# Chave segura para assinatura de JWTs (gerar chave aleatória em produção)
JWT_SECRET=super_secret_jwt_key_development_only_change_in_production
JWT_EXPIRES_IN=7d

# FRONTEND
VITE_API_URL=http://localhost:3001/api
