{
  "name": "@bokken/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST do Bokken Estudos em Node.js, Express e Prisma",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
